# Managed by Ansible (roles/monitoring). Do not edit by hand.
global:
  scrape_interval: {{ monitoring_prometheus_scrape_interval }}
  evaluation_interval: {{ monitoring_prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:{{ monitoring_prometheus_port }}"]

  # One node_exporter target per host in the inventory group, by private IP.
  # The list is rendered from the aws_ec2 dynamic inventory at run time.
  - job_name: node
    static_configs:
{% for host in groups[monitoring_prometheus_node_group] | sort %}
      - targets: ["{{ hostvars[host].private_ip }}:{{ monitoring_node_exporter_port }}"]
        labels:
          instance_name: "{{ host }}"
          role: "{{ hostvars[host].tags.Role | default('unknown') }}"
{% endfor %}

  # The CRRA application, via its k3s NodePort.
  - job_name: crra-app
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ monitoring_app_target_host }}:{{ monitoring_app_target_port }}"]
        labels:
          instance_name: crra-app
