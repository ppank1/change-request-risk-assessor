# Managed by Ansible (roles/monitoring). Do not edit by hand.
[server]
http_port = {{ monitoring_grafana_port }}
root_url = http://{{ jenkins_public_ip }}:{{ monitoring_grafana_port }}/

[security]
admin_user = {{ monitoring_grafana_admin_user }}
admin_password = {{ monitoring_grafana_admin_password }}
disable_gravatar = true

[users]
allow_sign_up = false

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
